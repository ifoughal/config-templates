{# ---------- HTTP PROXY ---------- #}
{%- if device.custom_field_data.get('http_proxy') %}
{%-   set http_proxy_id = device.custom_field_data.get('http_proxy') %}
{%-   if http_proxy_id %}
{%-     set http_proxy = ipam['Service'].objects.filter(id=http_proxy_id).first() %}
{%-     if http_proxy %}
{%-       set ip_addresses = http_proxy.ipaddresses %}
{%-       if ip_addresses and ip_addresses.first() %}
{%-         set ip_address = ip_addresses.first().address.ip %}
{%-         set port = http_proxy.ports[0] %}
export http_proxy={{ ip_address }}:{{ port }}
export HTTP_PROXY={{ ip_address }}:{{ port }}
{%-       else %}
no http_proxy
no HTTP_PROXY
{%-       endif %}
{%-     endif %}
{%-   endif %}
{%- else %}
no http_proxy
no HTTP_PROXY
{%- endif %}
