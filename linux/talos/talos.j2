{%- set cert_sans = ["127.0.0.1"] %}
{%- set install_disk = namespace(name="") %}
{%- set k8s_cluster = namespace(object=none, pod_subnet="test-1", service_subnet="test-2") %}
{%- set k8s_cluster.object = virtualmachine.cf.get("k8s_cluster") %}
{%- set openstack_image = namespace(object=none, name="", version="latest") %}
{%- set openstack_image.object = virtualmachine.cf.get("openstack_image") %}
{%- if openstack_image.object %}
{%-     set openstack_image.name = openstack_image.object.name %}
{%- endif %}
{%- if k8s_cluster.object %}
{%-     if k8s_cluster.object.pods_cidr.prefix is defined and k8s_cluster.object.pods_cidr.prefix %}
{%-         set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr.prefix | string %}
{%-     elif k8s_cluster.object.pods_cidr.display is defined and k8s_cluster.object.pods_cidr.display %}
{%-         set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr.display | string %}
{%-     else %}
{%-         set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr | string %}
{%-     endif %}
{%-     if k8s_cluster.object.service_cidr.prefix is defined and k8s_cluster.object.service_cidr.prefix %}
{%-         set k8s_cluster.service_subnet = k8s_cluster.object.service_cidr.prefix | string %}
{%-     elif k8s_cluster.object.service_cidr.display is defined and k8s_cluster.object.service_cidr.display %}
{%-         set k8s_cluster.service_subnet = k8s_cluster.object.service_cidr.display | string %}
{%-     else %}
{%-         set k8s_cluster.service_subnet = k8s_cluster.object.service_cidr | string %}
{%-     endif %}
{%- endif %}
{%- set openstack_image.version = openstack_image.name.split("-")[1] %}
{%- if virtualmachine.interfaces %}
{%-     for interface in virtualmachine.interfaces.all() %}
{%-         if interface.ip_addresses %}
{%-             for ip in interface.ip_addresses.all() %}
{%-                 set ip_address = ip.address.ip | string %}
{%-                 if ip_address not in cert_sans %}
{%-                     set _dummy = cert_sans.append(ip_address) %}
{%-                 endif %}
{%-             endfor %}
{%-         endif %}
{%-     endfor %}
{%- endif %}
{%- if virtualmachine.virtualdisks %}
{%-     for disk in virtualmachine.virtualdisks.all() %}
{%-         set is_operating_system_disk = disk.custom_field_data.get("operating_system") %}
{%-         if not install_disk.name and is_operating_system_disk == true %}
{%-             set install_disk.name = disk.name %}
{%-         endif %}
{%-     endfor %}
{%- endif -%}
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: "{{ virtualmachine.name }}"
---
version: v1alpha1
debug: false
persist: true
cluster:
  network:
    cni:
      name: none
    podSubnets: {{ [k8s_cluster.pod_subnet] | tojson }}
    serviceSubnets: {{ [k8s_cluster.service_subnet] | tojson }}
  proxy:
    disabled: true
machine:
  install:
    disk: {{ install_disk.name }} {# eg: /dev/sda The disk used for installations. #}
    image: ghcr.io/siderolabs/installer:v1.13.0  # {{ openstack_image.version }}  {# eg: v1.12.5 # Allows for supplying the image used to perform the installation. #}
    wipe: true  {# Indicates if the installation disk should be wiped at installation time. #}
    grubUseUKICmdline: true  {# Indicates if legacy GRUB bootloader should use kernel cmdline from the UKI instead of building it on the host. #}
  certSANs: {{ cert_sans | tojson }}
{%-     if virtualmachine.role.name == "storage-worker"  %}
  kernel:
    modules:
    - name: dm_mod
    - name: dm_snapshot
    - name: dm_thin_pool
  kubelet:
    extraMounts:
    - destination: /var/openebs/local
      type: bind
      source: /var/openebs/local
      options:
      - bind
      - rshared
{%-     endif %}
