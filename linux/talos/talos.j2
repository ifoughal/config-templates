{%- if virtualmachine.platform.name == "Talos"  %}
{%- set cert_sans = ["127.0.0.1"] %}
{%- set install_disk = namespace(name="") %}
{%- set openstack_image = virtualmachine.custom_field_data.get("openstack_image").name %}
{%- set installer_version = (openstack_image | string).split("-")[-1] if openstack_image else "" %}
{%- if virtualmachine.interfaces %}
{%-     for interface in virtualmachine.interfaces.all() %}
{%-         if interface.ip_addresses %}
{%-             for ip in interface.ip_addresses.all() %}
{%-                 set ip_address = ip.address.ip | string %}
{%-                 if ip_address not in cert_sans %}
{%-                     set _dummy = cert_sans.append(ip_address) %}
{%-                 endif %}
{%-             endfor %}
{%-         endif %}
{%-     endfor %}
{%- endif %}
{%- if virtualmachine.virtual_disks %}
{%-     for disk in virtualmachine.virtual_disks.all() %}
{%-             set install_disk.name = disk.name %}
{%-     endfor %}
{%- endif %}


---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: "{{ virtualmachine.name }}"
---
version: v1alpha1
debug: false
persist: true
cluster:
  network:
    cni:
      name: none
    # TODO: The pod subnet CIDRs should be dynamic.
    podSubnets: ["172.17.0.0/16"]
    serviceSubnets: ["172.18.0.0/16"]
  proxy:
    disabled: true
machine:
  install:
    disk: {{ install_disk.name }} # eg: /dev/sda The disk used for installations.
    image: ghcr.io/siderolabs/installer:v{{ installer_version }}     # eg: v1.12.5 # Allows for supplying the image used to perform the installation.
    wipe: true # Indicates if the installation disk should be wiped at installation time.
    grubUseUKICmdline: true # Indicates if legacy GRUB bootloader should use kernel cmdline from the UKI instead of building it on the host.

  certSANs: {{ cert_sans | tojson }}
{%-     if virtualmachine.role.name == "storage-worker"  %}
  kernel:
    modules:
    - name: dm_mod
    - name: dm_snapshot
    - name: dm_thin_pool

  kubelet:
    extraMounts:
    - destination: /var/openebs/local
      type: bind
      source: /var/openebs/local
      options:
      - bind
      - rshared
{%-     endif %}
{%- endif %}
