{%- set k8s_cluster = namespace(object=none, pod_subnet="172.17.0.0/16", pod_network="172.17.0.0", pod_mask_size="16") %}
{%- set k8s_cluster.object = virtualmachine.cf.get("k8s_cluster") %}
{%- if k8s_cluster.object %}
{%-     if k8s_cluster.object.pods_cidr is defined and k8s_cluster.object.pods_cidr %}
{%-         if k8s_cluster.object.pods_cidr.prefix is defined and k8s_cluster.object.pods_cidr.prefix %}
{%-             set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr.prefix | string %}
{%-         elif k8s_cluster.object.pods_cidr.display is defined and k8s_cluster.object.pods_cidr.display %}
{%-             set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr.display | string %}
{%-         else %}
{%-             set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr | string %}
{%-         endif %}
{%-     endif %}
{%- endif %}
{%- if "/" in k8s_cluster.pod_subnet %}
{%-     set pod_subnet_parts = k8s_cluster.pod_subnet.split("/") %}
{%-     set k8s_cluster.pod_network = pod_subnet_parts[0] %}
{%-     set k8s_cluster.pod_mask_size = pod_subnet_parts[1] %}
{%- endif %}
{%- set cilium_east_west = namespace(address="", port="6443", subnet="", interface="") %}
{%- if virtualmachine.interfaces %}
{%-     for interface in virtualmachine.interfaces.all() %}
{%-         set traffic_role = interface.custom_field_data.get("traffic_role", "") %}
{%-         if traffic_role == "east_west" and not cilium_east_west.address and interface.ip_addresses %}
{%-             set east_west_ipv4_addresses = interface.ip_addresses.filter(address__family=4) %}
{%-             if east_west_ipv4_addresses and east_west_ipv4_addresses.first() %}
{%-                 set east_west_ip = east_west_ipv4_addresses.first() %}
{%-                 set east_west_address = east_west_ip.address %}
{%-                 set cilium_east_west.address = east_west_address.ip | string %}
{%-                 set cilium_east_west.interface = interface.name %}
{%-                 if east_west_address.cidr is defined %}
{%-                     set cilium_east_west.subnet = east_west_address.cidr | string %}
{%-                 elif east_west_address.network is defined and east_west_address.prefixlen is defined %}
{%-                     set cilium_east_west.subnet = (east_west_address.network | string) ~ "/" ~ (east_west_address.prefixlen | string) %}
{%-                 elif east_west_ip.parent is defined and east_west_ip.parent %}
{%-                     if east_west_ip.parent.prefix is defined %}
{%-                         set cilium_east_west.subnet = east_west_ip.parent.prefix | string %}
{%-                     else %}
{%-                         set cilium_east_west.subnet = east_west_ip.parent | string %}
{%-                     endif %}
{%-                 endif %}
{%-             endif %}
{%-         endif %}
{%-     endfor %}
{%- endif %}
{#- Overrides from config context. Provide a `cilium` dict whose structure mirrors this file (e.g. `cilium.resources.limits.cpu`). #}
{%- if cilium is not defined %}
{%-   set cilium = {} %}
{%- endif %}
{%- set _resources = cilium.get('resources', {}) %}
{%- set _resources_limits = _resources.get('limits', {}) %}
{%- set _resources_requests = _resources.get('requests', {}) %}
{%- set _security = cilium.get('securityContext', {}) %}
{%- set _security_selinux = _security.get('seLinuxOptions', {}) %}
{%- set _security_caps = _security.get('capabilities', {}) %}
{%- set _update = cilium.get('updateStrategy', {}) %}
{%- set _update_rolling = _update.get('rollingUpdate', {}) %}
{%- set _l2 = cilium.get('l2announcements', {}) %}
{%- set _l2pod = cilium.get('l2podAnnouncements', {}) %}
{%- set _nodeport = cilium.get('nodePort', {}) %}
{%- set _bpf = cilium.get('bpf', {}) %}
{%- set _bpf_lru = _bpf.get('distributedLRU', {}) %}
{%- set _cni = cilium.get('cni', {}) %}
{%- set _cni_resources = _cni.get('resources', {}) %}
{%- set _cni_resources_requests = _cni_resources.get('requests', {}) %}
{%- set _cni_resources_limits = _cni_resources.get('limits', {}) %}
{%- set _envoy_config = cilium.get('envoyConfig', {}) %}
{%- set _envoy_config_ns = _envoy_config.get('secretsNamespace', {}) %}
{%- set _gateway = cilium.get('gatewayAPI', {}) %}
{%- set _gateway_class = _gateway.get('gatewayClass', {}) %}
{%- set _gateway_ns = _gateway.get('secretsNamespace', {}) %}
{%- set _gateway_host = _gateway.get('hostNetwork', {}) %}
{%- set _gateway_host_nodes = _gateway_host.get('nodes', {}) %}
{%- set _encrypt = cilium.get('encryption', {}) %}
{%- set _encrypt_strict = _encrypt.get('strictMode', {}) %}
{%- set _encrypt_strict_egress = _encrypt_strict.get('egress', {}) %}
{%- set _encrypt_strict_ingress = _encrypt_strict.get('ingress', {}) %}
{%- set _encrypt_wireguard = _encrypt.get('wireguard', {}) %}
{%- set _endpoint_routes = cilium.get('endpointRoutes', {}) %}
{%- set _hubble = cilium.get('hubble', {}) %}
{%- set _hubble_tls = _hubble.get('tls', {}) %}
{%- set _hubble_tls_auto = _hubble_tls.get('auto', {}) %}
{%- set _hubble_relay = _hubble.get('relay', {}) %}
{%- set _hubble_ui = _hubble.get('ui', {}) %}
{%- set _ipam = cilium.get('ipam', {}) %}
{%- set _ipam_operator = _ipam.get('operator', {}) %}
{%- set _node_ipam = cilium.get('nodeIPAM', {}) %}
{%- set _masq = cilium.get('ipMasqAgent', {}) %}
{%- set _k8s = cilium.get('k8s', {}) %}
{%- set _l2nd = cilium.get('l2NeighDiscovery', {}) %}
{%- set _maglev = cilium.get('maglev', {}) %}
{%- set _egress = cilium.get('egressGateway', {}) %}
{%- set _lb = cilium.get('loadBalancer', {}) %}
{%- set _lb_l7 = _lb.get('l7', {}) %}
{%- set _envoy = cilium.get('envoy', {}) %}
{%- set _tls = cilium.get('tls', {}) %}
{%- set _tls_ns = _tls.get('secretsNamespace', {}) %}
{%- set _etcd = cilium.get('etcd', {}) %}
{%- set _operator = cilium.get('operator', {}) %}
{%- set _nodeinit = cilium.get('nodeinit', {}) %}
{%- set _preflight = cilium.get('preflight', {}) %}
{%- set _cgroup = cilium.get('cgroup', {}) %}
{%- set _cgroup_automount = _cgroup.get('autoMount', {}) %}
{%- set _auth = cilium.get('authentication', {}) %}

k8sServiceHost: {{ cilium.get('k8sServiceHost', 'localhost') }}   # {{ cilium_east_west.address }}
k8sServicePort: {{ cilium.get('k8sServicePort', 7445) }}          # {{ cilium_east_west.port }}

cleanState: {{ cilium.get('cleanState', true) | tojson }}
cleanBpfState: {{ cilium.get('cleanBpfState', true) | tojson }}

rollOutCiliumPods: {{ cilium.get('rollOutCiliumPods', true) | tojson }}
dnsPolicy: "{{ cilium.get('dnsPolicy', 'ClusterFirst') }}"

resources:
  limits:
    cpu: {{ _resources_limits.get('cpu', '4000m') }}
    memory: {{ _resources_limits.get('memory', '4Gi') }}
  requests:
    cpu: {{ _resources_requests.get('cpu', '100m') }}
    memory: {{ _resources_requests.get('memory', '512Mi') }}

securityContext:
  allowPrivilegeEscalation: {{ _security.get('allowPrivilegeEscalation', false) | tojson }}
  privileged: {{ _security.get('privileged', false) | tojson }}
  seLinuxOptions:
    level: '{{ _security_selinux.get('level', 's0') }}'
    type: '{{ _security_selinux.get('type', 'spc_t') }}'
  capabilities:
    ciliumAgent: {{ _security_caps.get('ciliumAgent', ['CHOWN', 'KILL', 'NET_ADMIN', 'NET_RAW', 'IPC_LOCK', 'SYS_ADMIN', 'SYS_RESOURCE', 'PERFMON', 'BPF', 'DAC_OVERRIDE', 'FOWNER', 'SETGID', 'SETUID', 'SYSLOG']) | tojson }}
    mountCgroup: {{ _security_caps.get('mountCgroup', ['SYS_ADMIN', 'SYS_CHROOT', 'SYS_PTRACE']) | tojson }}
    applySysctlOverwrites: {{ _security_caps.get('applySysctlOverwrites', ['SYS_ADMIN', 'SYS_CHROOT', 'SYS_PTRACE']) | tojson }}
    cleanCiliumState: {{ _security_caps.get('cleanCiliumState', ['NET_ADMIN', 'SYS_ADMIN', 'SYS_RESOURCE', 'PERFMON', 'BPF']) | tojson }}

updateStrategy:
  type: {{ _update.get('type', 'RollingUpdate') }}
  rollingUpdate:
    maxUnavailable: {{ _update_rolling.get('maxUnavailable', 2) }}

# ipv4NativeRoutingCIDR: "{{ cilium_east_west.subnet }}"
ipv4NativeRoutingCIDR: "{{ cilium.get('ipv4NativeRoutingCIDR', k8s_cluster.pod_subnet) }}"

# -- Enable installation of PodCIDR routes between worker nodes if worker nodes share a common L2 network segment.
autoDirectNodeRoutes: {{ cilium.get('autoDirectNodeRoutes', true) | tojson }}

# -- Enable skipping of PodCIDR routes between worker
# nodes if the worker nodes are in a different L2 network segment.
directRoutingSkipUnreachable: {{ cilium.get('directRoutingSkipUnreachable', false) | tojson }}

# -- Annotate k8s node upon initialization with Cilium's metadata.
annotateK8sNode: {{ cilium.get('annotateK8sNode', true) | tojson }}

l2announcements:
  enabled: {{ _l2.get('enabled', false) | tojson }}

# TODO: test pods announcement
l2podAnnouncements:
  enabled: {{ _l2pod.get('enabled', false) | tojson }}
  # interface: "eth0"
  # interfacePattern: ""

################################################################################
# TODO: makes the interfaces assignment dynamic

# -- Specify which network interfaces can run the eBPF datapath. This means
# that a packet sent from a pod to a destination outside the cluster will be
# masqueraded (to an output device IPv4 address), if the output device runs the
# program. When not specified, probing will automatically detect devices that have
# a non-local route. This should be used only when autodetection is not suitable.

devices: "{{ cilium.get('devices', '') }}"

nodePort:
  enabled: {{ _nodeport.get('enabled', false) | tojson }}
#   directRoutingDevice: eth0
################################################################################

forceDeviceDetection: {{ cilium.get('forceDeviceDetection', false) | tojson }}

bpf:
  preallocateMaps: {{ _bpf.get('preallocateMaps', true) | tojson }}
  distributedLRU:
    enabled: {{ _bpf_lru.get('enabled', true) | tojson }}
  policyMapMax: {{ _bpf.get('policyMapMax', 16384) }}
  policyStatsMapMax: {{ _bpf.get('policyStatsMapMax', 65536) }}
  # @schema
  # type: [null, number, string]
  # @schema
  # -- (float64) Configure auto-sizing for all BPF maps based on available memory.
  # ref: https://docs.cilium.io/en/stable/network/ebpf/maps/
  # @default -- `0.0025`
  mapDynamicSizeRatio: {{ _bpf.get('mapDynamicSizeRatio', '~') }}
  lbAlgorithmAnnotation: {{ _bpf.get('lbAlgorithmAnnotation', true) | tojson }}
  lbModeAnnotation: {{ _bpf.get('lbModeAnnotation', true) | tojson }}
  masquerade: {{ _bpf.get('masquerade', true) | tojson }}
  # -- (string) Mode for Pod devices for the core datapath (veth, netkit, netkit-l2).
  # Note netkit is incompatible with TPROXY (`bpf.tproxy`).
  datapathMode: {{ _bpf.get('datapathMode', 'veth') }}

cni:
  install: {{ _cni.get('install', true) | tojson }}
  exclusive: {{ _cni.get('exclusive', false) | tojson }}
  resources:
    requests:
      cpu: {{ _cni_resources_requests.get('cpu', '100m') }}
      memory: {{ _cni_resources_requests.get('memory', '10Mi') }}
    limits:
      cpu: {{ _cni_resources_limits.get('cpu', 1) }}
      memory: {{ _cni_resources_limits.get('memory', '1Gi') }}

# -- Limit iptables-based egress masquerading to interface selector.
# egressMasqueradeInterfaces: ""

# -- Enable setting identity mark for local traffic.
# enableIdentityMark: true

envoyConfig:
  enabled: {{ _envoy_config.get('enabled', true) | tojson }}
  secretsNamespace:
    create: {{ _envoy_config_ns.get('create', true) | tojson }}
    name: {{ _envoy_config_ns.get('name', 'cilium-secrets') }}
  retryInterval: {{ _envoy_config.get('retryInterval', '15s') }}

gatewayAPI:
  enabled: {{ _gateway.get('enabled', true) | tojson }}
  enableAlpn: {{ _gateway.get('enableAlpn', true) | tojson }}
  enableAppProtocol: {{ _gateway.get('enableAppProtocol', true) | tojson }}
  externalTrafficPolicy: {{ _gateway.get('externalTrafficPolicy', 'Cluster') }}
  gatewayClass:
    create: '{{ _gateway_class.get('create', 'true') }}'
  secretsNamespace:
    create: {{ _gateway_ns.get('create', true) | tojson }}
    name: {{ _gateway_ns.get('name', 'cilium-secrets') }}
    sync: {{ _gateway_ns.get('sync', true) | tojson }}
  hostNetwork:
    enabled: {{ _gateway_host.get('enabled', false) | tojson }}
    # todo: test this
    # Specify the nodes where the Ingress listeners should be exposed
    nodes:
      # -- Specify the labels of the nodes where the Ingress listeners should be exposed
      #
      # matchLabels:
      #   kubernetes.io/os: linux
      #   kubernetes.io/hostname: kind-worker
      matchLabels: {{ _gateway_host_nodes.get('matchLabels', {}) | tojson }}

encryption:
  enabled: {{ _encrypt.get('enabled', false) | tojson }}
  type: {{ _encrypt.get('type', 'wireguard') }}
  nodeEncryption: {{ _encrypt.get('nodeEncryption', true) | tojson }}
  strictMode:
    egress:
      enabled: {{ _encrypt_strict_egress.get('enabled', false) | tojson }}
      cidr: "{{ _encrypt_strict_egress.get('cidr', '') }}"
      allowRemoteNodeIdentities: {{ _encrypt_strict_egress.get('allowRemoteNodeIdentities', false) | tojson }}
    ingress:
      enabled: {{ _encrypt_strict_ingress.get('enabled', false) | tojson }}
  wireguard:
    persistentKeepalive: {{ _encrypt_wireguard.get('persistentKeepalive', '0s') }}

endpointRoutes:
  # -- Enable use of per endpoint routes instead of routing via
  # the cilium_host interface.
  enabled: {{ _endpoint_routes.get('enabled', false) | tojson }}

# -- Enable routing to a service that has zero endpoints
enableNoServiceEndpointsRoutable: {{ cilium.get('enableNoServiceEndpointsRoutable', true) | tojson }}

hubble:
  enabled: {{ _hubble.get('enabled', true) | tojson }}
  tls:
    enabled: {{ _hubble_tls.get('enabled', true) | tojson }}
    auto:
      enabled: {{ _hubble_tls_auto.get('enabled', true) | tojson }}
      method: {{ _hubble_tls_auto.get('method', 'cronJob') }}
  relay:
    enabled: {{ _hubble_relay.get('enabled', true) | tojson }}
  ui:
    enabled: {{ _hubble_ui.get('enabled', true) | tojson }}

installNoConntrackIptablesRules: {{ cilium.get('installNoConntrackIptablesRules', false) | tojson }}  # TODO: test with true

ipam:
  # ref: https://docs.cilium.io/en/stable/network/concepts/ipam/
  mode: {{ _ipam.get('mode', 'cluster-pool') }}
  operator:
    clusterPoolIPv4PodCIDRList: {{ _ipam_operator.get('clusterPoolIPv4PodCIDRList', [k8s_cluster.pod_network ~ '/' ~ k8s_cluster.pod_mask_size]) | tojson }}
    clusterPoolIPv4MaskSize: {{ _ipam_operator.get('clusterPoolIPv4MaskSize', 24) }}

defaultLBServiceIPAM: {{ cilium.get('defaultLBServiceIPAM', 'lbipam') }}
nodeIPAM:
  enabled: {{ _node_ipam.get('enabled', true) | tojson }}

ipMasqAgent:
  enabled: {{ _masq.get('enabled', false) | tojson }}
  # config:
  #   masqLinkLocalIPv6: false
  #   masqLinkLocal: true
  #   nonMasqueradeCIDRs:
  #   - 172.20.0.1/32   # DB subnets for example
  #   - 172.20.0.2/32   # DB subnets for example
  #   - 172.20.0.3/32   # DB subnets for example

k8s:
  requireIPv4PodCIDR: {{ _k8s.get('requireIPv4PodCIDR', true) | tojson }}
  requireIPv6PodCIDR: {{ _k8s.get('requireIPv6PodCIDR', false) | tojson }}
  apiServerURLs: "{{ _k8s.get('apiServerURLs', 'https://' ~ cilium_east_west.address ~ ':' ~ cilium_east_west.port) }}"

kubeProxyReplacement: {{ cilium.get('kubeProxyReplacement', true) | tojson }}

l2NeighDiscovery:
  enabled: {{ _l2nd.get('enabled', false) | tojson }}

l7Proxy: {{ cilium.get('l7Proxy', true) | tojson }}

maglev:
  tableSize: {{ _maglev.get('tableSize', 65521) }}
  hashSeed: {{ _maglev.get('hashSeed', 'lcZ10lyASHpL/lK6') }}

enableIPv4Masquerade: {{ cilium.get('enableIPv4Masquerade', true) | tojson }}

enableMasqueradeRouteSource: {{ cilium.get('enableMasqueradeRouteSource', false) | tojson }}  # TODO test with true

egressGateway:
  enabled: {{ _egress.get('enabled', false) | tojson }}

# -- Configure service load balancing
loadBalancer:
  algorithm: {{ _lb.get('algorithm', 'maglev') }}
  mode: {{ _lb.get('mode', 'snat') }}
  acceleration: {{ _lb.get('acceleration', 'best-effort') }}
  dsrDispatch: {{ _lb.get('dsrDispatch', 'opt') }}
  serviceTopology: {{ _lb.get('serviceTopology', false) | tojson }}
  l7:
    backend: {{ _lb_l7.get('backend', 'disabled') }}
    ports: {{ _lb_l7.get('ports', []) | tojson }}
    algorithm: {{ _lb_l7.get('algorithm', 'round_robin') }}

envoy:
  enabled: {{ _envoy.get('enabled', true) | tojson }}
  baseID: {{ _envoy.get('baseID', 0) }}
  # -- For cases when CiliumEnvoyConfig is not used directly (Ingress, Gateway), configures Cilium BPF Metadata listener filter
  # to use the original source address when extracting the metadata for a request.
  useOriginalSourceAddress: {{ _envoy.get('useOriginalSourceAddress', true) | tojson }}

tls:
  secretsNamespace:
    create: {{ _tls_ns.get('create', true) | tojson }}
    name: {{ _tls_ns.get('name', 'cilium-secrets') }}

# -- Tunneling protocol to use in tunneling mode and for ad-hoc tunnels.
# Possible values:
#   - ""
#   - vxlan
#   - geneve
tunnelProtocol: "{{ cilium.get('tunnelProtocol', '') }}"

underlayProtocol: "{{ cilium.get('underlayProtocol', 'ipv4') }}"

routingMode: "{{ cilium.get('routingMode', 'native') }}"

{%- set _static_routes = cilium.get('staticRoutes', []) %}
{%- if _static_routes %}
staticRoutes:
{%-   for route in _static_routes %}
  - prefix: "{{ route.get('prefix', '') }}"
    nexthop: "{{ route.get('nexthop', '') }}"
{%-     set _route_iface = route.get('interface', '') | replace('ens3', cilium_east_west.interface) if cilium_east_west.interface else route.get('interface', '') %}
{%-     if _route_iface %}
    interface: "{{ _route_iface }}"
{%-     elif cilium_east_west.interface %}
    interface: "{{ cilium_east_west.interface }}"
{%-     endif %}
{%-   endfor %}
{%- endif %}

# todo: add etcd later...
etcd:
  enabled: {{ _etcd.get('enabled', false) | tojson }}
  # -- List of etcd endpoints
  endpoints: {{ _etcd.get('endpoints', ['https://CHANGE-ME:2379']) | tojson }}
  ssl: {{ _etcd.get('ssl', false) | tojson }}

operator:
  enabled: {{ _operator.get('enabled', true) | tojson }}
  rollOutPods: {{ _operator.get('rollOutPods', false) | tojson }}
  replicas: {{ _operator.get('replicas', 2) }}

# todo: might be necessary with talos?
nodeinit:
  enabled: {{ _nodeinit.get('enabled', false) | tojson }}

# todo: must be used during upgrades...
preflight:
  # -- Enable Cilium pre-flight resources (required for upgrade)
  enabled: {{ _preflight.get('enabled', false) | tojson }}

# -- Configure cgroup related configuration
cgroup:
  autoMount:
    enabled: {{ _cgroup_automount.get('enabled', false) | tojson }}
  hostRoot: {{ _cgroup.get('hostRoot', '/sys/fs/cgroup') }}

authentication:
  enabled: {{ _auth.get('enabled', true) | tojson }}

enableInternalTrafficPolicy: {{ cilium.get('enableInternalTrafficPolicy', true) | tojson }}

enableLBIPAM: {{ cilium.get('enableLBIPAM', true) | tojson }}

{#- Pass through any top-level keys from the `cilium` config context not handled above.
    This allows adding arbitrary Helm values (e.g. clustermesh, kvstoremesh) without
    modifying this template — just add them to the VM's cilium config context dict. -#}
{%- set _handled = [
  'k8sServiceHost', 'k8sServicePort',
  'cleanState', 'cleanBpfState',
  'rollOutCiliumPods', 'dnsPolicy',
  'resources', 'securityContext', 'updateStrategy',
  'ipv4NativeRoutingCIDR',
  'autoDirectNodeRoutes', 'directRoutingSkipUnreachable', 'annotateK8sNode',
  'l2announcements', 'l2podAnnouncements',
  'devices', 'nodePort', 'forceDeviceDetection',
  'bpf', 'cni',
  'envoyConfig', 'gatewayAPI',
  'encryption', 'endpointRoutes', 'enableNoServiceEndpointsRoutable',
  'hubble', 'installNoConntrackIptablesRules',
  'ipam', 'defaultLBServiceIPAM', 'nodeIPAM', 'ipMasqAgent',
  'k8s', 'kubeProxyReplacement',
  'l2NeighDiscovery', 'l7Proxy',
  'maglev', 'enableIPv4Masquerade', 'enableMasqueradeRouteSource',
  'egressGateway', 'loadBalancer',
  'envoy', 'tls',
  'tunnelProtocol', 'underlayProtocol', 'routingMode',
  'etcd', 'operator', 'nodeinit', 'preflight', 'cgroup',
  'authentication', 'enableInternalTrafficPolicy', 'enableLBIPAM',
  'staticRoutes',
] %}
{%- for key, val in cilium.items() %}
{%-   if key not in _handled %}
{%-     if val is mapping or (val is iterable and val is not string) %}
{{ key }}:
{{ val | toyaml | indent(2, first=True) }}
{%-     else %}
{{ key }}: {{ val | toyaml }}
{%-     endif %}
{%-   endif %}
{%- endfor %}
