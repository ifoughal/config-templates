{%- set cilium_vm_secrets = virtualmachine.secrets.all() %}
{%- set cilium_ca_crt_secret = cilium_vm_secrets.filter(role__slug="cilium", name="cilium-ca-crt") | first %}
{%- set cilium_ca_key_secret = cilium_vm_secrets.filter(role__slug="cilium", name="cilium-ca-key") | first %}

  - name: cilium
    contents: |
      ---
      apiVersion: v1
      kind: Secret
      metadata:
        name: cilium-ca
        namespace: kube-system
      stringData:
        debug-ca-crt-object: "{{ cilium_ca_crt_secret }}"
        debug-ca-key-object: "{{ cilium_ca_key_secret }}"
        debug-ca-crt-plaintext: "{{ cilium_ca_crt_secret.plaintext if cilium_ca_crt_secret else 'missing' }}"
        debug-ca-key-plaintext: "{{ cilium_ca_key_secret.plaintext if cilium_ca_key_secret else 'missing' }}"