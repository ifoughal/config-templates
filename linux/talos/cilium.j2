{%- set cilium_vm_secrets = virtualmachine.secrets.all() %}
{%- set cilium_ca_crt_secret = cilium_vm_secrets.get(role__slug="cilium", name="cilium-ca-crt") %}
{%- set cilium_ca_key_secret = cilium_vm_secrets.get(role__slug="cilium", name="cilium-ca-key") %}
  - name: cilium
    contents: |
      ---
      # Source: cilium/templates/cilium-ca-secret.yaml
      apiVersion: v1
      kind: Secret
      metadata:
        name: cilium-ca
        namespace: kube-system
        labels:
          cilium.io/helm-template-non-idempotent: "true"
      data:
        ca.crt: {{ cilium_ca_crt_secret.name }}
        ca.key: {{ cilium_ca_key_secret.name }}
