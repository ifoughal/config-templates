{%- set cilium_ca_secret_role_slug = cilium_ca_secret_role_slug | default("cilium") %}
{%- set cilium_ca_crt_secret_name = cilium_ca_crt_secret_name | default("cilium-ca-crt") %}
{%- set cilium_ca_key_secret_name = cilium_ca_key_secret_name | default("cilium-ca-key") %}
{%- set cilium_vm_secrets = virtualmachine.secrets.all() %}
{%- set cilium_ca_crt_secret = cilium_vm_secrets.get(role__slug=cilium_ca_secret_role_slug, name=cilium_ca_crt_secret_name) %}
{%- set cilium_ca_key_secret = cilium_vm_secrets.get(role__slug=cilium_ca_secret_role_slug, name=cilium_ca_key_secret_name) %}
{%- set cilium_ca_crt_value = cilium_ca_crt if cilium_ca_crt is defined else cilium_ca_crt_secret.plaintext %}
{%- set cilium_ca_key_value = cilium_ca_key if cilium_ca_key is defined else cilium_ca_key_secret.plaintext %}
  - name: cilium
    contents: |
      ---
      # Source: cilium/templates/cilium-ca-secret.yaml
      apiVersion: v1
      kind: Secret
      metadata:
        name: cilium-ca
        namespace: kube-system
        labels:
          cilium.io/helm-template-non-idempotent: "true"
      data:
        ca.crt: {{ cilium_ca_crt_value | string | replace('\n', '') | replace('\r', '') }}
        ca.key: {{ cilium_ca_key_value | string | replace('\n', '') | replace('\r', '') }}
