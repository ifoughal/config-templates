{%- set k8s_cluster = namespace(object=none, pod_subnet="172.17.0.0/16", pod_network="172.17.0.0", pod_mask_size="16") %}
{%- set k8s_cluster.object = virtualmachine.cf.get("k8s_cluster") %}
{%- if k8s_cluster.object %}
{%-     if k8s_cluster.object.pods_cidr is defined and k8s_cluster.object.pods_cidr %}
{%-         if k8s_cluster.object.pods_cidr.prefix is defined and k8s_cluster.object.pods_cidr.prefix %}
{%-             set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr.prefix | string %}
{%-         elif k8s_cluster.object.pods_cidr.display is defined and k8s_cluster.object.pods_cidr.display %}
{%-             set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr.display | string %}
{%-         else %}
{%-             set k8s_cluster.pod_subnet = k8s_cluster.object.pods_cidr | string %}
{%-         endif %}
{%-     endif %}
{%- endif %}
{%- if "/" in k8s_cluster.pod_subnet %}
{%-     set pod_subnet_parts = k8s_cluster.pod_subnet.split("/") %}
{%-     set k8s_cluster.pod_network = pod_subnet_parts[0] %}
{%-     set k8s_cluster.pod_mask_size = pod_subnet_parts[1] %}
{%- endif %}

{%- set cilium_east_west = namespace(address="", port="6443", subnet="", interface="") %}
{%- if virtualmachine.interfaces %}
{%-     for interface in virtualmachine.interfaces.all() %}
{%-         set traffic_role = interface.custom_field_data.get("traffic_role", "") %}
{%-         if traffic_role == "east_west" and not cilium_east_west.address and interface.ip_addresses %}
{%-             set east_west_ipv4_addresses = interface.ip_addresses.filter(address__family=4) %}
{%-             if east_west_ipv4_addresses and east_west_ipv4_addresses.first() %}
{%-                 set east_west_ip = east_west_ipv4_addresses.first() %}
{%-                 set east_west_address = east_west_ip.address %}
{%-                 set cilium_east_west.address = east_west_address.ip | string %}
{%-                 set cilium_east_west.interface = interface.name %}
{%-                 if east_west_address.cidr is defined %}
{%-                     set cilium_east_west.subnet = east_west_address.cidr | string %}
{%-                 elif east_west_address.network is defined and east_west_address.prefixlen is defined %}
{%-                     set cilium_east_west.subnet = (east_west_address.network | string) ~ "/" ~ (east_west_address.prefixlen | string) %}
{%-                 elif east_west_ip.parent is defined and east_west_ip.parent %}
{%-                     if east_west_ip.parent.prefix is defined %}
{%-                         set cilium_east_west.subnet = east_west_ip.parent.prefix | string %}
{%-                     else %}
{%-                         set cilium_east_west.subnet = east_west_ip.parent | string %}
{%-                     endif %}
{%-                 endif %}
{%-             endif %}
{%-         endif %}
{%-     endfor %}
{%- endif %}
{#- Overrides from config context. Provide a `cilium` dict whose structure mirrors this file. #}
{%- if cilium is not defined %}
{%-   set cilium = {} %}
{%- endif %}
{%- set _cluster = cilium.get('cluster', {}) %}
{%- set _cluster_id = _cluster.get('id', k8s_cluster.pod_subnet.split(".")[1]) %}
{%- set _security = cilium.get('securityContext', {}) %}
{%- set _security_caps = _security.get('capabilities', {}) %}
{%- set _cgroup = cilium.get('cgroup', {}) %}
{%- set _cgroup_automount = _cgroup.get('autoMount', {}) %}
{%- set _bpf = cilium.get('bpf', {}) %}
{%- set _bpf_lru = _bpf.get('distributedLRU', {}) %}
{%- set _cni = cilium.get('cni', {}) %}
{%- set _cni_resources = _cni.get('resources', {}) %}
{%- set _cni_resources_requests = _cni_resources.get('requests', {}) %}
{%- set _cni_resources_limits = _cni_resources.get('limits', {}) %}
{%- set _ipam = cilium.get('ipam', {}) %}
{%- set _envoy_config = cilium.get('envoyConfig', {}) %}
{%- set _envoy_config_ns = _envoy_config.get('secretsNamespace', {}) %}
{%- set _node_ipam = cilium.get('nodeIPAM', {}) %}
{%- set _k8s = cilium.get('k8s', {}) %}
{%- set _maglev = cilium.get('maglev', {}) %}
{%- set _ipam_operator = _ipam.get('operator', {}) %}


cluster:
  name: {{ _cluster.get('name', 'talos-cluster-' + _cluster_id) }}
  id: {{ _cluster.get('id', _cluster_id) }}

k8sServiceHost: {{ cilium.get('k8sServiceHost', 'localhost') }}
k8sServicePort: {{ cilium.get('k8sServicePort', 7445) }}

kubeProxyReplacement: {{ cilium.get('kubeProxyReplacement', true) | tojson }}

securityContext:
  capabilities:
    ciliumAgent: {{ _security_caps.get('ciliumAgent', ['CHOWN', 'KILL', 'NET_ADMIN', 'NET_RAW', 'IPC_LOCK', 'SYS_ADMIN', 'SYS_RESOURCE', 'DAC_OVERRIDE', 'FOWNER', 'SETGID', 'SETUID']) | tojson }}
    cleanCiliumState: {{ _security_caps.get('cleanCiliumState', ['NET_ADMIN', 'SYS_ADMIN', 'SYS_RESOURCE']) | tojson }}

cgroup:
  autoMount:
    enabled: {{ _cgroup_automount.get('enabled', false) | tojson }}
  hostRoot: {{ _cgroup.get('hostRoot', '/sys/fs/cgroup') }}

ipam:
  mode: {{ _ipam.get('mode', 'kubernetes') }}
  operator:
    clusterPoolIPv4PodCIDRList: {{ _ipam_operator.get('clusterPoolIPv4PodCIDRList', [k8s_cluster.pod_network ~ '/' ~ k8s_cluster.pod_mask_size]) | tojson }}
    clusterPoolIPv4MaskSize: {{ _ipam_operator.get('clusterPoolIPv4MaskSize', 24) }}

defaultLBServiceIPAM: {{ cilium.get('defaultLBServiceIPAM', 'lbipam') }}
nodeIPAM:
  enabled: {{ _node_ipam.get('enabled', true) | tojson }}

k8s:
  requireIPv4PodCIDR: {{ _k8s.get('requireIPv4PodCIDR', true) | tojson }}
  requireIPv6PodCIDR: {{ _k8s.get('requireIPv6PodCIDR', false) | tojson }}
  apiServerURLs: "{{ _k8s.get('apiServerURLs', 'https://' ~ cilium_east_west.address ~ ':' ~ cilium_east_west.port) }}"


routingMode: "{{ cilium.get('routingMode', 'native') }}"

ipv4NativeRoutingCIDR: "{{ cilium.get('ipv4NativeRoutingCIDR', k8s_cluster.pod_subnet) }}"


autoDirectNodeRoutes: {{ cilium.get('autoDirectNodeRoutes', true) | tojson }}
directRoutingSkipUnreachable: {{ cilium.get('directRoutingSkipUnreachable', false) | tojson }}


annotateK8sNode: {{ cilium.get('annotateK8sNode', true) | tojson }}


cni:
  install: {{ _cni.get('install', true) | tojson }}
  exclusive: {{ _cni.get('exclusive', true) | tojson }}
  resources:
    requests:
      cpu: {{ _cni_resources_requests.get('cpu', '100m') }}
      memory: {{ _cni_resources_requests.get('memory', '10Mi') }}
    limits:
      cpu: {{ _cni_resources_limits.get('cpu', 1) }}
      memory: {{ _cni_resources_limits.get('memory', '1Gi') }}


envoy:
  enabled: {{ _envoy.get('enabled', true) | tojson }}
  baseID: {{ _envoy.get('baseID', 0) }}
  # -- For cases when CiliumEnvoyConfig is not used directly (Ingress, Gateway), configures Cilium BPF Metadata listener filter
  # to use the original source address when extracting the metadata for a request.
  useOriginalSourceAddress: {{ _envoy.get('useOriginalSourceAddress', true) | tojson }}

envoyConfig:
  enabled: {{ _envoy_config.get('enabled', true) | tojson }}
  secretsNamespace:
    create: {{ _envoy_config_ns.get('create', true) | tojson }}
    name: {{ _envoy_config_ns.get('name', 'cilium-secrets') }}
  retryInterval: {{ _envoy_config.get('retryInterval', '15s') }}

bpf:
  preallocateMaps: {{ _bpf.get('preallocateMaps', true) | tojson }}
  distributedLRU:
    enabled: {{ _bpf_lru.get('enabled', true) | tojson }}
  policyMapMax: {{ _bpf.get('policyMapMax', 16384) }}
  policyStatsMapMax: {{ _bpf.get('policyStatsMapMax', 65536) }}
  # @schema
  # type: [null, number, string]
  # @schema
  # -- (float64) Configure auto-sizing for all BPF maps based on available memory.
  # ref: https://docs.cilium.io/en/stable/network/ebpf/maps/
  # @default -- `0.0025`
  mapDynamicSizeRatio: {{ _bpf.get('mapDynamicSizeRatio', '~') }}
  lbAlgorithmAnnotation: {{ _bpf.get('lbAlgorithmAnnotation', true) | tojson }}
  lbModeAnnotation: {{ _bpf.get('lbModeAnnotation', true) | tojson }}
  masquerade: {{ _bpf.get('masquerade', false) | tojson }}
  # -- (string) Mode for Pod devices for the core datapath (veth, netkit, netkit-l2).
  # Note netkit is incompatible with TPROXY (`bpf.tproxy`).
  datapathMode: {{ _bpf.get('datapathMode', 'veth') }}


maglev:
  tableSize: {{ _maglev.get('tableSize', 65521) }}
  hashSeed: {{ _maglev.get('hashSeed', 'lcZ10lyASHpL/lK6') }}

enableIPv4Masquerade: {{ cilium.get('enableIPv4Masquerade', false) | tojson }}
enableIPv6Masquerade: {{ cilium.get('enableIPv6Masquerade', false) | tojson }}

{#- Pass through any top-level keys from the `cilium` config context not handled above.
    This allows adding arbitrary Helm values (e.g. clustermesh, kvstoremesh) without
    modifying this template — just add them to the VM's cilium config context dict. -#}
{%- set _handled = [
  'k8sServiceHost', 'k8sServicePort',
  'cleanState', 'cleanBpfState',
  'rollOutCiliumPods', 'dnsPolicy',
  'resources', 'securityContext', 'updateStrategy',
  'ipv4NativeRoutingCIDR',
  'autoDirectNodeRoutes', 'directRoutingSkipUnreachable', 'annotateK8sNode',
  'l2announcements', 'l2podAnnouncements',
  'devices', 'nodePort', 'forceDeviceDetection',
  'bpf', 'cni',
  'envoyConfig', 'gatewayAPI',
  'encryption', 'endpointRoutes', 'enableNoServiceEndpointsRoutable',
  'hubble', 'installNoConntrackIptablesRules',
  'ipam', 'defaultLBServiceIPAM', 'nodeIPAM', 'ipMasqAgent',
  'k8s', 'kubeProxyReplacement',
  'l2NeighDiscovery', 'l7Proxy',
  'maglev', 'enableIPv4Masquerade', 'enableMasqueradeRouteSource',
  'egressGateway', 'loadBalancer',
  'envoy', 'tls',
  'tunnelProtocol', 'underlayProtocol', 'routingMode',
  'etcd', 'operator', 'nodeinit', 'preflight', 'cgroup',
  'authentication', 'enableInternalTrafficPolicy', 'enableLBIPAM',
  'staticRoutes', 'hashSeed', 'tableSize', 'MTU', 'cluster'
] %}
{%- for key, val in cilium.items() %}
{%-   if key not in _handled %}
{%-     if val is mapping or (val is iterable and val is not string) %}
{{ key }}:
{{ val | toyaml | indent(2, first=True) }}
{%-     else %}
{{ key }}: {{ val | toyaml }}
{%-     endif %}
{%-   endif %}
{%- endfor %}